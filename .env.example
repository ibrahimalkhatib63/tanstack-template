# Client (safe to expose)
VITE_CONVEX_URL=your-convex-deployment-url-here
VITE_SENTRY_DSN=your-sentry-dsn-here
SENTRY_AUTH_TOKEN=your-sentry-auth-token-here

# Server secrets: set these on the Convex deployment, NOT in this file.
#   npx convex env set ANTHROPIC_API_KEY sk-ant-...
#   npx convex env set AUTH_APPLE_ID <Apple Services ID>
#   npx convex env set AUTH_APPLE_SECRET <Apple client secret JWT>
#   npx convex env set SITE_URL <your site URL>
#   (plus JWT_PRIVATE_KEY and JWKS from: npx @convex-dev/auth)
